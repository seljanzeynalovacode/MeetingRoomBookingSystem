# ================================
# MeetingRoomBookingSystem Docker Environment Template
# ================================
# Bu fayl GitHub-a COMMIT OLUNUR!
# Local maşında: cp .env.example .env
# Sonra .env-də real dəyərləri doldur

# Database
DB_SA_PASSWORD=your_sql_server_password_here
DB_CONNECTION_STRING=Server=sqlserver,1433;Database=MRBSystemDb;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True;Connection Timeout=30;ConnectRetryCount=5;ConnectRetryInterval=10;

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production

# JWT Configuration
JWT_KEY=your-super-secret-key-minimum-32-characters-long-here-1234
JWT_ISSUER=MRBSystem
JWT_AUDIENCE=MRBSystemUsers
JWT_ACCESS_TOKEN_EXPIRATION=60
JWT_REFRESH_TOKEN_EXPIRATION=30

# Admin User Seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FIRSTNAME=System
ADMIN_LASTNAME=Admin

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROMEMAIL=your-email@gmail.com
SMTP_FROMNAME=Meeting Room Booking System
SMTP_ENABLESSL=true

# Gemini API Configuration (for AI chatbot)
GEMINI_API_KEY=your-gemini-api-key-here

# Frontend Configuration
FRONTEND_URL=http://localhost:80

# Timezone
TIMEZONE=Asia/Baku

# Node Environment
NODE_ENV=production
