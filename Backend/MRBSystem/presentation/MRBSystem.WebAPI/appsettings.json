{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Npgsql": "Error",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss}] [{Level:u3}] {Message:lj}{NewLine}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss}] [{Level:u3}] {Message:lj}{NewLine}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "MRBSystem"
    }
  },
  "AllowedHosts": "*",
  "Localization": {
    "TimeZoneId": "Asia/Baku"
  },
  "ConnectionStrings": {
    "MRBSystemConnectionString": "Server=sqlserver,1433;Database=MRBSystemDb;User Id=sa;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;Connection Timeout=30;ConnectRetryCount=5;ConnectRetryInterval=10;"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_SECURE_32_PLUS_CHARACTER_SECRET_KEY",
    "Issuer": "MRBSystem",
    "Audience": "MRBSystemUsers",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "SeedAdmin": {
    "Email": "selcan.zeynalova.2022@gmail.com",
    "Password": "REPLACE_IN_ENV_OR_USER_SECRETS",
    "FirstName": "Selcan",
    "LastName": "Admin"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "seljanaz@code.edu.az",
    "Password": "your-app-password",
    "FromEmail": "seljanaz@code.edu.az",
    "FromName": "Meeting Room Booking System",
    "EnableSsl": true
  },
  "Gemini": {
    "ApiKey": "your-gemini-api-key"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:80", "http://localhost", "http://localhost:8080"]
  }
}
